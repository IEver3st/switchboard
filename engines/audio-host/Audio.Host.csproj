<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Realtime DSP must meet its callback deadline in every configuration; unoptimized spatial
         rendering takes 20-30 ms per 10 ms frame. Debugging still works with optimized code. -->
    <Optimize>true</Optimize>
    <NoiseNativeDir Condition="'$(NoiseNativeDir)' == ''">$(MSBuildProjectDirectory)\..\..\native\noise-bridge\target\release</NoiseNativeDir>
    <!-- Optional libDF staged by `bun run build:deepfilternet-native`; it stays inactive until the model is acquired. -->
    <DeepFilterNativeDll>$(MSBuildProjectDirectory)\..\..\.switchboard\build\noise-native\df.dll</DeepFilterNativeDll>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Spatial\kemar-48000.bin" LogicalName="Switchboard.Kemar" />
    <EmbeddedResource Include="Spatial\NOTICE.md" LogicalName="Switchboard.Kemar.Notice" />
    <EmbeddedResource Include="Spatial\HEAD-TRACKER-NOTICE.txt" LogicalName="Switchboard.HeadTracker.Notice" />
    <EmbeddedResource Include="..\..\scripts\repair-xm6-head-tracker.ps1" LogicalName="Switchboard.HeadTracker.Repair" />
    <PackageReference Include="NAudio" Version="3.0.1" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(NoiseNativeDir)')">
    <Content Include="$(NoiseNativeDir)\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NoiseNativeDir)\noise-native-manifest.json" Link="noise-native-manifest.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(NoiseNativeDir)\noise-native-manifest.json')" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(DeepFilterNativeDll)') And !Exists('$(NoiseNativeDir)\df.dll')">
    <Content Include="$(DeepFilterNativeDll)" Link="df.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
