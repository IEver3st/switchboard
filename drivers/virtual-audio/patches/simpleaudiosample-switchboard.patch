+#define SWITCHBOARD_TRANSPORT_CAPACITY_BYTES (38400)
+
+typedef struct _SWITCHBOARD_TRANSPORT_RING
+{
+    BYTE Buffer[SWITCHBOARD_TRANSPORT_CAPACITY_BYTES];
+    volatile LONG64 ReadSequence;
+    volatile LONG64 WriteSequence;
+} SWITCHBOARD_TRANSPORT_RING;
+
+static SWITCHBOARD_TRANSPORT_RING g_MicrophoneTransport = {};
+static SWITCHBOARD_TRANSPORT_RING g_StreamTransport = {};
+
+static SWITCHBOARD_TRANSPORT_RING* GetTransportRing(eDeviceType deviceType)
+{
+    switch (deviceType)
+    {
+    case eMicrophoneRenderDevice:
+    case eMicrophoneCaptureDevice:
+        return &g_MicrophoneTransport;
+    case eStreamRenderDevice:
+    case eStreamCaptureDevice:
+        return &g_StreamTransport;
+    default:
+        return NULL;
+    }
+}
+
+static VOID ResetTransportReader(eDeviceType deviceType)
+{
+    SWITCHBOARD_TRANSPORT_RING* ring = GetTransportRing(deviceType);
+    if (ring == NULL) return;
+    LONG64 write = InterlockedCompareExchange64(&ring->WriteSequence, 0, 0);
+    InterlockedExchange64(&ring->ReadSequence, write);
+}
+
+static ULONG WriteTransportBytes(SWITCHBOARD_TRANSPORT_RING* ring, const BYTE* source, ULONG byteCount)
+{
+    LONG64 write = InterlockedCompareExchange64(&ring->WriteSequence, 0, 0);
+    LONG64 read = InterlockedCompareExchange64(&ring->ReadSequence, 0, 0);
+    LONG64 pending = write > read ? write - read : 0;
+    ULONG used = (ULONG)min((LONG64)SWITCHBOARD_TRANSPORT_CAPACITY_BYTES, pending);
+    ULONG accepted = min(byteCount, SWITCHBOARD_TRANSPORT_CAPACITY_BYTES - used);
+    ULONG offset = (ULONG)(write % SWITCHBOARD_TRANSPORT_CAPACITY_BYTES);
+    ULONG first = min(accepted, SWITCHBOARD_TRANSPORT_CAPACITY_BYTES - offset);
+    RtlCopyMemory(ring->Buffer + offset, source, first);
+    if (accepted > first) RtlCopyMemory(ring->Buffer, source + first, accepted - first);
+    KeMemoryBarrier();
+    InterlockedExchange64(&ring->WriteSequence, write + accepted);
+    return accepted;
+}
+
+static ULONG ReadTransportBytes(SWITCHBOARD_TRANSPORT_RING* ring, BYTE* destination, ULONG byteCount)
+{
+    LONG64 read = InterlockedCompareExchange64(&ring->ReadSequence, 0, 0);
+    LONG64 write = InterlockedCompareExchange64(&ring->WriteSequence, 0, 0);
+    LONG64 pending = write > read ? write - read : 0;
+    ULONG available = (ULONG)min((LONG64)byteCount, pending);
+    ULONG offset = (ULONG)(read % SWITCHBOARD_TRANSPORT_CAPACITY_BYTES);
+    ULONG first = min(available, SWITCHBOARD_TRANSPORT_CAPACITY_BYTES - offset);
+    RtlCopyMemory(destination, ring->Buffer + offset, first);
+    if (available > first) RtlCopyMemory(destination + first, ring->Buffer, available - first);
+    if (available < byteCount) RtlZeroMemory(destination + available, byteCount - available);
+    KeMemoryBarrier();
+    InterlockedExchange64(&ring->ReadSequence, read + available);
+    return available;
+}
+
